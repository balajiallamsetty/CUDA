# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vignak?retryWrites=true&w=majority

# JWT — production requires 32+ characters
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin for CORS and cookies
CLIENT_URL=http://127.0.0.1:5173

# Optional SMTP (required in production for password reset delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vignak.solutions

# Local document uploads (private; never served as static public files)
UPLOAD_DIR=

# Payments (provider-ready). Until set, only admin-recorded payments work.
# Never store card data. Webhook marks Paid only after signature verification.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Future S3-compatible storage (unused in Part 1; storageService is swap-ready)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: seed admin via `npm run seed:admin`
# Protected cleanup account (see `npm run db:cleanup-users`)
ADMIN_EMAIL=cudasolutionstech@gmail.com
ADMIN_PASSWORD=
# Alias accepted by cleanup script if ADMIN_PASSWORD is unset:
# ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=CUDA Solutions Admin
# Set true only when intentionally rotating the protected admin password during cleanup
ADMIN_RESET_PASSWORD=

# User cleanup maintenance (explicit invoke only — never runs on server startup)
# 1) Dry run: DB_CLEANUP_DRY_RUN=true npm run db:cleanup-users
# 2) Live:    DB_CLEANUP_CONFIRM=true ADMIN_PASSWORD=<secret> npm run db:cleanup-users
DB_CLEANUP_DRY_RUN=true
DB_CLEANUP_CONFIRM=
