# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vignak?retryWrites=true&w=majority

# JWT (use a long random secret in production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin for CORS and cookies
CLIENT_URL=http://localhost:5173

# Optional: seed admin via `npm run seed:admin`
ADMIN_EMAIL=admin@vignak.local
ADMIN_PASSWORD=ChangeMeStrongPassword123!
ADMIN_NAME=Vignak Admin
